# AWS
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-opus-4-6-v1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# App paths
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
REPO_DIR=./data/repos
REPORT_DIR=./data/reports

# Limits
MAX_UPLOAD_MB=50
MAX_FILE_CHARS=200000
MAX_CHUNK_CHARS=4000
CHUNK_OVERLAP_CHARS=400
MAX_RETRIEVAL_RESULTS=8

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
GITHUB_TOKEN=

# Local demo defaults. Set MODERNIZEAI_USE_BEDROCK_AGENTS=true on EC2 after IAM and Bedrock model access are configured.
MODERNIZEAI_USE_BEDROCK_AGENTS=false
MODERNIZEAI_REQUIRE_BEDROCK_AGENTS=false
MODERNIZEAI_USE_BEDROCK_EMBEDDINGS=false
MODERNIZEAI_ALLOW_LOCAL_EMBEDDINGS=true
